            "path": "new/logo",
            "digest": "x",
            "size": 10
          },
          {
            "path": "keep",
            "digest": "k",
            "size": 5
          },
          {
            "path": "fresh",
            "digest": "f",
            "size": 7
          }
        ]
      ],
      "kwargs": {},
      "assertArgsUnchanged": true,
      "expected": {
