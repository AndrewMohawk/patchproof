{
  "id": "v2-r01-t02",
  "repoId": "owned-v2-r01",
  "split": "development",
  "title": "Preserve a final partial list block",
  "description": "This ListWeave snapshot exposes blocks(values, width), used to divide in-memory list data into consecutive display batches. A loop-bound regression drops a final short batch. Restore all documented behaviors. All inputs and outputs are JSON values; numbers are finite and integers are within JavaScript safe range.",
  "requirements": [
    {
      "id": "R01",
      "text": "For list values and a positive integer width, blocks returns consecutive nonempty sublists of at most width elements in original order. Every element appears exactly once. Include the final short block without padding; width 1 produces singleton blocks, and an empty values returns []."
    },
    {
      "id": "R02",
      "text": "For valid calls, blocks leaves values and its nested lists and dictionaries unchanged, including calls with a final partial block."
    },
    {
      "id": "R03",
      "text": "values must be a list and width must have Python type int, excluding booleans; any violation raises TypeError. With those types valid, zero or negative width raises ValueError, including when values is empty."
    }
  ],
  "files": {
    "blocks.py": "# ListWeave: original synthetic list-maintenance module. CC0-1.0.\ndef blocks(values, width):\n    if not isinstance(values, list) or type(width) is not int:\n        raise TypeError(\"expected a list and integer width\")\n    if width <= 0:\n        raise ValueError(\"width must be positive\")\n    complete_end = len(values) - len(values) % width\n    return [values[start:start + width] for start in range(0, complete_end, width)]\n"
  },
  "editAllowlist": [
    "blocks.py"
  ],
