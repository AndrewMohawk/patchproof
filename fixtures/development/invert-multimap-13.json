  "title": "Retain duplicate inverted keys",
  "description": "Invert a mapping into lists of original keys, in input insertion order.",
  "requirements": [
    {
      "id": "R01",
      "text": "Collect every key for repeated values."
    },
    {
      "id": "R02",
      "text": "Preserve key order and leave input unchanged."
    },
    {
      "id": "R03",
      "text": "Unhashable values raise TypeError."
    }
  ],
  "files": {
    "solution.py": "def invert(mapping):\n    return {value:[key] for key,value in mapping.items()}\n"
  },
