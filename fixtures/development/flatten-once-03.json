  "title": "Flatten exactly one level",
  "description": "Flatten one level of nested lists, preserving deeper lists and input order.",
  "requirements": [
    {
      "id": "R01",
      "text": "Flatten exactly one level and retain all values."
    },
    {
      "id": "R02",
      "text": "Empty input returns empty without mutation."
    },
    {
      "id": "R03",
      "text": "A non-list member raises TypeError."
    }
  ],
  "files": {
    "solution.py": "def flatten_once(groups):\n    return [value for group in groups for value in group if not isinstance(value,list)]\n"
