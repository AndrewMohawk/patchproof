  "title": "Remove a literal prefix once",
  "description": "Remove a specified literal prefix once, and only at the start.",
  "requirements": [
    {
      "id": "R01",
      "text": "Remove exactly one complete leading prefix."
    },
    {
      "id": "R02",
      "text": "Empty or missing prefixes preserve text."
    },
