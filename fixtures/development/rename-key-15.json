  "split": "development",
  "title": "Refuse accidental key overwrite",
  "description": "Return a mapping with a key renamed while leaving the input unchanged; refuse collisions and preserve absent keys.",
  "requirements": [
    {
      "id": "R01",
      "text": "Rename an existing key and retain its value."
    },
    {
      "id": "R02",
      "text": "Absent or identical source key leaves the mapping equal and input unchanged."
    },
    {
      "id": "R03",
      "text": "Existing destination different from source raises ValueError."
    }
  ],
  "files": {
    "solution.py": "def rename_key(mapping, old, new):\n    result=dict(mapping)\n    if old in result:\n        result[new]=result.pop(old)\n    return result\n"
  },
