{
  "id": "v2-r01-t03",
  "repoId": "owned-v2-r01",
  "split": "development",
  "title": "Honor signed cyclic list shifts",
  "description": "This ListWeave snapshot contains rotate(values, steps), an in-memory sequence reordering helper. A refactor that handles the shift magnitude lost the leftward direction of negative steps. Restore the documented signed rotation. Inputs and outputs are JSON values with finite numbers and JavaScript-safe integers.",
  "requirements": [
    {
      "id": "R01",
      "text": "For list values and integer steps, rotate moves elements cyclically right by steps positions when positive and left by -steps when negative, preserving relative cyclic order. Reduce steps modulo list length; zero and whole-length multiples keep the order, a singleton keeps its value, and an empty list returns [] for every integer steps."
    },
    {
      "id": "R02",
      "text": "For valid calls, rotate leaves values and all nested lists and dictionaries unchanged, including negative shifts that change the returned order."
    },
    {
      "id": "R03",
      "text": "values must be a list and steps must have Python type int, excluding booleans; any violation raises TypeError, even when values is empty."
    }
  ],
  "files": {
    "cycles.py": "# ListWeave: original synthetic list-maintenance module. CC0-1.0.\ndef rotate(values, steps):\n    if not isinstance(values, list) or type(steps) is not int:\n        raise TypeError(\"expected a list and integer steps\")\n    if not values:\n        return []\n    shift = abs(steps) % len(values)\n    return values[-shift:] + values[:-shift] if shift else values[:]\n"
  },
  "editAllowlist": [
    "cycles.py"
  ],
  "entrypoint": "cycles.py",
