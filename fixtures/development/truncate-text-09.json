  "title": "Count suffix inside the limit",
  "description": "Truncate text to a nonnegative width, including the suffix in that width.",
  "requirements": [
    {
      "id": "R01",
      "text": "Output length never exceeds limit and suffix counts toward limit."
    },
    {
      "id": "R02",
      "text": "Already-short text is unchanged and zero limit returns empty."
    },
    {
      "id": "R03",
      "text": "Negative limit raises ValueError."
    }
  ],
  "files": {
    "solution.py": "def truncate(text, limit, suffix=\"...\"):\n    return text if len(text)<=limit else text[:limit]+suffix\n"
  },
