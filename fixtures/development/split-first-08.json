      "id": "R03",
      "text": "Empty separator raises ValueError."
    }
  ],
  "files": {
    "solution.py": "def split_first(text, separator):\n    parts = text.split(separator)\n    return [parts[0], parts[1] if len(parts)>1 else \"\"]\n"
  },
