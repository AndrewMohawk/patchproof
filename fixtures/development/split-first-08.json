  "title": "Preserve the unsplit remainder",
  "description": "Split a string on only its first separator; return [text,empty] when absent.",
  "requirements": [
    {
      "id": "R01",
      "text": "Split at the first complete separator only."
    },
    {
      "id": "R02",
      "text": "Absent separator yields [text,empty string]."
    },
