  "title": "Retain falsy nested values",
  "description": "Look up a sequence of dictionary keys; use default only when a component is missing.",
  "requirements": [
    {
      "id": "R01",
      "text": "Return existing nested values even when falsy."
    },
    {
      "id": "R02",
      "text": "Empty path returns the original mapping by value without mutation."
    },
    {
      "id": "R03",
      "text": "Traversal into a non-dictionary returns default."
    }
  ],
  "files": {
    "solution.py": "def get_path(data, path, default=None):\n    value=data\n    for key in path:\n        value=value.get(key) if isinstance(value,dict) else None\n    return value or default\n"
  },
