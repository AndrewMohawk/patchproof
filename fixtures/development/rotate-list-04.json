  "repoId": "fixture-01",
  "split": "development",
  "title": "Normalize list rotation",
  "description": "Rotate a list left by an integer distance; negative distance rotates right.",
  "requirements": [
    {
      "id": "R01",
      "text": "Normalize distance modulo input length."
    },
    {
      "id": "R02",
      "text": "Empty lists return empty and inputs are unchanged."
    },
    {
      "id": "R03",
      "text": "A non-integer distance raises TypeError."
    }
  ],
  "files": {
    "solution.py": "def rotate_left(values, distance):\n    return values[distance:] + values[:distance]\n"
  },
