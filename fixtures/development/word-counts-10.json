  "title": "Fold Unicode words consistently",
  "description": "Count whitespace-separated words after Unicode case folding, retaining punctuation.",
  "requirements": [
    {
      "id": "R01",
      "text": "Count casefold-equivalent words together."
    },
    {
      "id": "R02",
      "text": "Split on whitespace; whitespace-only input yields empty counts."
    },
    {
      "id": "R03",
      "text": "Non-string text raises TypeError."
    }
  ],
  "files": {
    "solution.py": "def word_counts(text):\n    result = {}\n    for word in text.lower().split(\" \"):\n        result[word] = result.get(word,0)+1\n    return result\n"
  },
