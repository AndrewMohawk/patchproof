{
  "id": "v2-r01-t04",
  "repoId": "owned-v2-r01",
  "split": "development",
  "title": "Keep unpaired values during list weaving",
  "description": "This ListWeave snapshot provides interleave(left, right), which weaves two in-memory sequences for a paired display. A zip-based refactor loses entries when list lengths differ. Restore the full documented behavior for JSON data; numbers are finite and integers stay within JavaScript safe range.",
  "requirements": [
    {
      "id": "R01",
      "text": "For lists left and right, interleave returns left[0], right[0], left[1], right[1], and so on while both have elements, then all remaining elements of the longer list in their original order. Empty lists are supported, including both empty. Every occurrence is retained, even equal or nested JSON values."
    },
    {
      "id": "R02",
      "text": "For valid calls, interleave leaves both caller lists and all nested lists and dictionaries unchanged, including unequal-length inputs."
    },
    {
      "id": "R03",
      "text": "Both left and right must be lists; if either is any other JSON type, including None, raise TypeError before producing a result."
    }
  ],
  "files": {
    "braids.py": "# ListWeave: original synthetic list-maintenance module. CC0-1.0.\ndef interleave(left, right):\n    if not isinstance(left, list) or not isinstance(right, list):\n        raise TypeError(\"expected two lists\")\n    result = []\n    for a, b in zip(left, right):\n        result.extend([a, b])\n    return result\n"
  },
  "editAllowlist": [
    "braids.py"
  ],
