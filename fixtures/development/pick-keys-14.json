  "title": "Select only present keys",
  "description": "Return requested present keys, even when their values are falsy, omitting missing keys.",
  "requirements": [
    {
      "id": "R01",
      "text": "Include requested keys by membership, not value truthiness."
    },
    {
      "id": "R02",
      "text": "Ignore missing keys without modifying inputs."
    },
    {
      "id": "R03",
      "text": "Non-dictionary mapping raises TypeError."
    }
  ],
  "files": {
    "solution.py": "def pick(mapping, keys):\n    return {key:mapping[key] for key in keys if mapping.get(key)}\n"
