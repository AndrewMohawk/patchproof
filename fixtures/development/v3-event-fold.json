{
  "id": "v3-event-fold",
  "repoId": "owned-v3-event-fold",
  "split": "development",
  "title": "Out-of-order updates and retried events produce a stale materialized view",
  "description": "A dashboard rebuilds its cards from an event log that can arrive out of order and include duplicate deliveries. The materializer must validate and deduplicate first, apply deterministic revision order, preserve label order and honor deletion/recreation. Repair the fold without dropping legitimate later updates.",
  "requirements": [
    {
      "id": "R01",
      "text": "Validate every event before folding. Deduplicate identical repeated eventId values; a repeated eventId with any conflicting content raises ValueError. Apply unique events by sequence ascending, then eventId lexical order for ties, independent of input order."
    },
    {
      "id": "R02",
      "text": "Create replaces the entity with its title and ordered unique labels. Rename changes title only. Labels removes every named label, then appends new labels in add-list order with duplicates suppressed; a label present in both remove and add is removed and appended again. Every applied active update sets version to its sequence."
    },
    {
      "id": "R03",
      "text": "Delete removes the entity. Rename and labels events for an inactive entity are ignored; only create can reactivate it. Return active entities sorted by exact entity id, each with id,title,labels,version."
    },
    {
      "id": "R04",
      "text": "Events are a list of objects with exactly eventId,entity,sequence,kind,data. Ids are nonempty strings; sequence is a nonnegative plain integer. Create data has exactly title (string), labels (list of nonempty strings); rename has title; labels has add/remove lists of nonempty strings; delete has empty data. Invalid input raises ValueError."
    },
    {
      "id": "R05",
      "text": "Preserve every input event and nested payload. Handle empty streams, duplicate labels, empty titles and equal-sequence ties deterministically."
    }
  ],
  "files": {
    "event_fold.py": "\"\"\"Original PatchProof maintenance fixture. SPDX-License-Identifier: CC0-1.0.\"\"\"\n\nfrom copy import deepcopy\nimport json\n\n\ndef _labels(value):\n    return type(value) is list and all(type(item) is str and item for item in value)\n\n\ndef _validate(events):\n    if type(events) is not list:\n        raise ValueError(\"events must be a list\")\n    seen = {}\n    unique = []\n    for event in events:\n        if type(event) is not dict or set(event) != {\"eventId\", \"entity\", \"sequence\", \"kind\", \"data\"}:\n            raise ValueError(\"invalid event fields\")\n        if any(type(event[key]) is not str or not event[key] for key in (\"eventId\", \"entity\")):\n            raise ValueError(\"invalid event identity\")\n        if type(event[\"sequence\"]) is not int or event[\"sequence\"] < 0:\n            raise ValueError(\"invalid sequence\")\n        kind, data = event[\"kind\"], event[\"data\"]\n        if type(data) is not dict:\n            raise ValueError(\"invalid event data\")\n        if kind == \"create\":\n            valid = set(data) == {\"title\", \"labels\"} and type(data[\"title\"]) is str and _labels(data[\"labels\"])\n        elif kind == \"rename\":\n            valid = set(data) == {\"title\"} and type(data[\"title\"]) is str\n        elif kind == \"labels\":\n            valid = set(data) == {\"add\", \"remove\"} and _labels(data[\"add\"]) and _labels(data[\"remove\"])\n        elif kind == \"delete\":\n            valid = not data\n        else:\n            valid = False\n        if not valid:\n            raise ValueError(\"invalid event kind or payload\")\n        encoded = json.dumps(event, sort_keys=True, separators=(\",\", \":\"))\n        if event[\"eventId\"] in seen:\n            if seen[event[\"eventId\"]] != encoded:\n                raise ValueError(\"conflicting repeated event id\")\n            continue\n        seen[event[\"eventId\"]] = encoded\n        unique.append(event)\n    return unique\n\n\ndef _ordered_unique(items):\n    return sorted(set(items))\n\n\ndef _apply(state, event):\n    kind, data = event[\"kind\"], event[\"data\"]\n    if kind == \"delete\":\n        return None\n    if kind == \"create\":\n        return {\"id\": event[\"entity\"], \"title\": data[\"title\"],\n                \"labels\": _ordered_unique(data[\"labels\"]), \"version\": event[\"sequence\"]}\n    if state is None:\n        return None\n    updated = deepcopy(state)\n    if kind == \"rename\":\n        updated[\"title\"] = data[\"title\"]\n    else:\n        retained = list(updated[\"labels\"])\n        updated[\"labels\"] = _ordered_unique(retained + data[\"add\"])\n    updated[\"version\"] = event[\"sequence\"]\n    return updated\n\n\ndef fold_events(events):\n    \"\"\"Build a reproducible materialized view from retried out-of-order events.\"\"\"\n    unique = _validate(events)\n    ordered = unique\n    states = {}\n    for event in ordered:\n        entity = event[\"entity\"]\n        states[entity] = _apply(states.get(entity), event)\n    return [states[key] for key in sorted(states) if states[key] is not None]\n"
  },
