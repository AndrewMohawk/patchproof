  "split": "development",
  "title": "Average central values for even length",
  "description": "Return the sorted median without sorting the caller list in place.",
  "requirements": [
    {
      "id": "R01",
      "text": "Even length uses the mean of two central values."
    },
    {
      "id": "R02",
      "text": "Odd length returns the center and never mutates input."
    },
    {
      "id": "R03",
      "text": "Empty input raises ValueError."
    }
  ],
  "files": {
    "solution.py": "def median(values):\n    values.sort()\n    return values[len(values)//2]\n"
  },
