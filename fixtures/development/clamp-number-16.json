  "split": "development",
  "title": "Validate clamp bounds",
  "description": "Clamp a number into the inclusive [lower,upper] range.",
  "requirements": [
    {
      "id": "R01",
      "text": "Return the number within inclusive bounds."
    },
    {
      "id": "R02",
      "text": "Equal bounds return that bound."
    },
    {
      "id": "R03",
      "text": "Reversed bounds raise ValueError."
    }
  ],
  "files": {
    "solution.py": "def clamp(value, lower, upper):\n    return min(upper,max(lower,value))\n"
  },
