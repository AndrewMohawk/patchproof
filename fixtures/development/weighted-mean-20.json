  "split": "development",
  "title": "Normalize weighted means",
  "description": "Compute sum(value*weight)/sum(weight), rejecting length mismatch and zero total weight.",
  "requirements": [
    {
      "id": "R01",
      "text": "Normalize by total weight, not number of items."
    },
    {
      "id": "R02",
      "text": "Negative weights are supported when total is nonzero."
    },
    {
      "id": "R03",
      "text": "Unequal lengths or zero total weight raise ValueError."
    }
  ],
  "files": {
    "solution.py": "def weighted_mean(values, weights):\n    return sum(v*w for v,w in zip(values,weights))/len(values)\n"
  },
