  "split": "development",
  "title": "Keep final partial chunk",
  "description": "Split a list into consecutive chunks of positive integer size; keep the short trailing chunk.",
  "requirements": [
    {
      "id": "R01",
      "text": "Keep input order and the final partial chunk."
    },
    {
      "id": "R02",
      "text": "Empty input returns an empty list without modifying input."
    },
    {
      "id": "R03",
      "text": "Nonpositive size raises ValueError."
    }
  ],
  "files": {
    "solution.py": "def chunks(values, size):\n    return [values[i:i+size] for i in range(0,len(values)-size+1,size)]\n"
  },
