{
  "id": "v2-r06-t03",
  "repoId": "owned-v2-r06",
  "split": "calibration",
  "title": "Keep separated operation runs distinct in compact instruction displays",
  "description": "The compact instruction formatter has begun combining matching labels from separate sections. Restore adjacent-run formatting without changing the input sequence.",
  "requirements": [
    {
      "id": "R01",
      "text": "operation_runs(labels) returns [label, positive_count] pairs for maximal consecutive runs, in sequence order. Equal labels separated by any different label form separate output rows. Equality is exact string equality, including case, Unicode code points and empty strings. Empty input returns []."
    },
    {
      "id": "R02",
      "text": "labels must be a list whose every member is a string; otherwise raise TypeError. Do not coerce numbers, booleans, null, nested lists or objects into labels."
    },
    {
      "id": "R03",
      "text": "The supplied labels list must remain unchanged on successful formatting and on a validation exception."
    }
  ],
  "files": {
    "runs.py": "\"\"\"Compact adjacent workshop operations for display.\"\"\"\n\n\ndef operation_runs(labels):\n    if not isinstance(labels, list) or any(not isinstance(x, str) for x in labels):\n        raise TypeError(\"labels must be a list of strings\")\n    result = []\n    for label in labels:\n        if any(row[0] == label for row in result):\n            next(row for row in result if row[0] == label)[1] += 1\n        else:\n            result.append([label, 1])\n    return result\n"
  },
  "editAllowlist": [
    "runs.py"
  ],
  "entrypoint": "runs.py",
