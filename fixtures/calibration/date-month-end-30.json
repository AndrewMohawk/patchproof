{
  "id": "date-month-end-30",
  "repoId": "fixture-06",
  "split": "calibration",
  "title": "Handle leap-year month endings",
  "description": "Return final calendar day of the month containing an ISO date.",
  "requirements": [
    {
      "id": "R01",
      "text": "Compute month end including leap years and December."
    },
    {
      "id": "R02",
      "text": "Any day in a month returns the same month end."
    },
    {
      "id": "R03",
      "text": "Invalid ISO dates raise ValueError."
    }
  ],
  "files": {
    "solution.py": "from datetime import date\ndef month_end(value):\n    current=date.fromisoformat(value)\n    return current.replace(day=28).isoformat()\n"
  },
