{
  "id": "hex-bytes-25",
  "repoId": "fixture-05",
  "split": "calibration",
  "title": "Parse case-insensitive spaced hex",
  "description": "Parse an even-length hex string after stripping ASCII whitespace; return byte integer list.",
  "requirements": [
    {
      "id": "R01",
      "text": "Accept uppercase/lowercase digits with ASCII whitespace anywhere."
    },
    {
      "id": "R02",
      "text": "Empty text returns an empty list."
    },
    {
      "id": "R03",
      "text": "Odd length or invalid hex raises ValueError."
    }
  ],
  "files": {
    "solution.py": "def parse_hex(text):\n    return [int(text[i:i+2],16) for i in range(0,len(text),2)]\n"
  },
