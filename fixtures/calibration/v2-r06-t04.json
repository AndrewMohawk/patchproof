{
  "id": "v2-r06-t04",
  "repoId": "owned-v2-r06",
  "split": "calibration",
  "title": "Allow a workshop tray to reach its exact capacity",
  "description": "Tray planning now opens another tray when adding an item would exactly fill the current tray. Restore the documented contiguous greedy grouping, including zero-unit placeholders.",
  "requirements": [
    {
      "id": "R01",
      "text": "batch_units(units, capacity) processes amounts in their original order. Append each amount to the current batch when its resulting sum is at most capacity; otherwise start a new batch containing that amount. Return the resulting nonempty batches without reordering or dropping amounts, including zeros. Empty units returns []."
    },
    {
      "id": "R02",
      "text": "units must be a list of integers and capacity a positive integer. Booleans and fractional numbers are invalid. Wrong container or numeric types raise TypeError. Nonpositive capacity or any amount below zero or above capacity raises ValueError. Validate every amount before returning a result."
    },
    {
      "id": "R03",
      "text": "The supplied units list must remain unchanged on both success and a validation exception."
    }
  ],
  "files": {
    "batches.py": "\"\"\"Contiguous capacity grouping for workshop tray plans.\"\"\"\n\n\ndef batch_units(units, capacity):\n    if not isinstance(units, list) or type(capacity) is not int:\n        raise TypeError(\"invalid list or capacity type\")\n    if capacity <= 0:\n        raise ValueError(\"capacity must be positive\")\n    for amount in units:\n        if type(amount) is not int:\n            raise TypeError(\"unit amounts must be integers\")\n        if amount < 0 or amount > capacity:\n            raise ValueError(\"unit amount outside capacity\")\n    result = []\n    current = []\n    load = 0\n    for amount in units:\n        if current and load + amount >= capacity:\n            result.append(current)\n            current = []\n            load = 0\n        current.append(amount)\n        load += amount\n    if current:\n        result.append(current)\n    return result\n"
  },
  "editAllowlist": [
    "batches.py"
  ],
  "entrypoint": "batches.py",
