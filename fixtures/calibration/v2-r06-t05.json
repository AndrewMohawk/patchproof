{
  "id": "v2-r06-t05",
  "repoId": "owned-v2-r06",
  "split": "calibration",
  "title": "Use the requested final position when moving a workshop step",
  "description": "Moving an instruction toward the end currently places it one slot early. The editor API defines destination as an index in the final sequence, and callers retain their original sequence for undo previews.",
  "requirements": [
    {
      "id": "R01",
      "text": "reposition_step(steps, source, destination) returns a reordered list with the original source element at the destination index in the final list. Keep the relative order of every other element. Positions are zero based; source equal to destination returns the same values. Retain all string contents exactly, including duplicate, empty and Unicode labels."
    },
    {
      "id": "R02",
      "text": "steps must be a list of strings and source and destination must be integers, excluding booleans and fractional values; wrong types raise TypeError. Both positions must be at least zero and less than the length of steps; otherwise raise ValueError. Thus an empty list has no valid positions, and negative positions are not Python-style offsets."
    },
    {
      "id": "R03",
      "text": "The supplied steps list must remain unchanged on both a successful move and a validation exception."
    }
  ],
  "files": {
    "sequence.py": "\"\"\"Reorder workshop instruction sequences using final list positions.\"\"\"\n\n\ndef reposition_step(steps, source, destination):\n    if not isinstance(steps, list) or any(not isinstance(x, str) for x in steps):\n        raise TypeError(\"steps must be a list of strings\")\n    if type(source) is not int or type(destination) is not int:\n        raise TypeError(\"positions must be integers\")\n    if source < 0 or source >= len(steps) or destination < 0 or destination >= len(steps):\n        raise ValueError(\"position outside sequence\")\n    result = list(steps)\n    selected = result.pop(source)\n    if source < destination:\n        destination -= 1\n    result.insert(destination, selected)\n    return result\n"
  },
  "editAllowlist": [
    "sequence.py"
  ],
  "entrypoint": "sequence.py",
