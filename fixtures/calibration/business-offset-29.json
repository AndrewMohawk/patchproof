  "id": "business-offset-29",
  "repoId": "fixture-06",
  "split": "calibration",
  "title": "Skip weekend days during offsets",
  "description": "Add a signed weekday offset to an ISO date; zero preserves any starting date.",
  "requirements": [
    {
      "id": "R01",
      "text": "Count Monday through Friday only while moving."
    },
    {
      "id": "R02",
      "text": "Zero offset returns the original valid ISO date."
    },
    {
      "id": "R03",
      "text": "Invalid ISO date raises ValueError."
    }
  ],
  "files": {
    "solution.py": "from datetime import date,timedelta\ndef add_weekdays(value, amount):\n    return (date.fromisoformat(value)+timedelta(days=amount)).isoformat()\n"
  },
