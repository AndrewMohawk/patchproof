{
  "id": "v2-r06-t02",
  "repoId": "owned-v2-r06",
  "split": "calibration",
  "title": "Consume completed instruction occurrences only once",
  "description": "A completion-accounting regression removes every occurrence of a repeated instruction label. Restore the occurrence-based behavior used by workshop progress views.",
  "requirements": [
    {
      "id": "R01",
      "text": "remaining_steps(planned, completed) returns the planned labels left after consuming one earliest still-unconsumed equal planned occurrence per completed label. Compare strings exactly, including Unicode, case and empty labels. Preserve the original order of survivors. Extra completed occurrences and absent labels are ignored; empty planned returns [] and empty completed returns planned values."
    },
    {
      "id": "R02",
      "text": "Both arguments must be lists containing only strings; otherwise raise TypeError. Validate both entire lists even when planned is empty or a completed label would not match any planned label."
    },
    {
      "id": "R03",
      "text": "Both supplied lists must remain unchanged on success and on a validation exception."
    }
  ],
  "files": {
    "progress.py": "\"\"\"Completion accounting for ordered workshop instruction labels.\"\"\"\n\n\ndef remaining_steps(planned, completed):\n    for labels in (planned, completed):\n        if not isinstance(labels, list) or any(not isinstance(x, str) for x in labels):\n            raise TypeError(\"step labels must be lists of strings\")\n    counts = {}\n    for label in completed:\n        counts[label] = counts.get(label, 0) + 1\n    result = []\n    for label in planned:\n        if counts.get(label, 0) > 0:\n            counts[label] = counts[label]\n        else:\n            result.append(label)\n    return result\n"
  },
  "editAllowlist": [
    "progress.py"
  ],
  "entrypoint": "progress.py",
