  "repoId": "fixture-06",
  "split": "calibration",
  "title": "Use half-open interval overlap",
  "description": "Return the length of overlap between valid half-open numeric intervals.",
  "requirements": [
    {
      "id": "R01",
      "text": "Compute nonnegative intersection length."
    },
    {
      "id": "R02",
      "text": "Touching or empty intervals have zero overlap."
    },
    {
      "id": "R03",
      "text": "Reversed endpoints raise ValueError."
    }
  ],
  "files": {
    "solution.py": "def overlap(a, b):\n    return min(a[1],b[1])-max(a[0],b[0])\n"
  },
