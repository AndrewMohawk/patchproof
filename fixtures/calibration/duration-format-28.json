  "repoId": "fixture-06",
  "split": "calibration",
  "title": "Carry duration hours without wrapping",
  "description": "Format nonnegative integer seconds as hours:minutes:seconds with two-digit minimum fields.",
  "requirements": [
    {
      "id": "R01",
      "text": "Carry seconds into minutes and hours."
    },
    {
      "id": "R02",
      "text": "Hours may exceed 23 and zero has three fields."
    },
    {
      "id": "R03",
      "text": "Negative input raises ValueError."
    }
  ],
  "files": {
    "solution.py": "def format_duration(seconds):\n    return f\"{seconds//3600%24:02d}:{seconds//60%60:02d}:{seconds%60:02d}\"\n"
  },
