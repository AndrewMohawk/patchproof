  "split": "calibration",
  "title": "Keep repeated query keys",
  "description": "Parse a query string into decoded key/value pairs, preserving repeats and blank values.",
  "requirements": [
    {
      "id": "R01",
      "text": "Decode percent escapes and plus as space."
    },
    {
      "id": "R02",
      "text": "Retain blank values and repeated pair order."
    },
    {
      "id": "R03",
      "text": "An optional leading question mark is ignored."
    }
  ],
  "files": {
    "solution.py": "from urllib.parse import parse_qsl\ndef parse_pairs(query):\n    return [list(pair) for pair in parse_qsl(query)]\n"
  },
