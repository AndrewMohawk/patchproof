{
  "name": "patchproof",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "25.5.0",
    "npm": "11.8.0"
  },
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "dev": "node apps/api/src/main.ts",
    "doctor": "node scripts/product-cli.ts doctor",
    "run": "node scripts/product-cli.ts run",
    "mock-run": "node scripts/cli.ts mock-run",
    "test:browser": "node scripts/verify-browser.ts",
    "check:contracts": "node scripts/check-contract-lock.ts"
  },
  "dependencies": {
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "playwright": "1.58.2",
    "typescript": "5.9.3"
  }
}
