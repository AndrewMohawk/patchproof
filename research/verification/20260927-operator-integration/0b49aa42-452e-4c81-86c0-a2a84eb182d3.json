  "fixture": {
    "id": "stable-unique-01",
    "repoId": "fixture-01",
    "split": "development",
    "title": "Stable duplicate removal",
    "description": "Repair unique(values) so deduplication preserves first occurrence order and caller-owned input. None must raise TypeError.",
    "requirements": [
      {
        "id": "R01",
        "text": "Return each distinct value once in first-occurrence order, using Python equality."
      },
      {
        "id": "R02",
        "text": "Do not mutate the input list."
      },
      {
        "id": "R03",
        "text": "Raise TypeError for None."
      }
    ],
    "files": {
      "solution.py": "def unique(values):\n    if values is None:\n        return []\n    values.sort()\n    return list(set(values))\n"
    },
